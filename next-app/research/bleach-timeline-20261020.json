  "franchise": {
    "id": "01e50fbd-8947-43b7-add7-f39c5f990046",
    "name": "ROCK MUSICAL BLEACH（ブリミュ）",
    "created_at": "2026-02-08T16:26:41.990203+00:00",
    "updated_at": "2026-02-08T16:26:41.990203+00:00",
    "slug": "bleach",
    "intro": null,
    "description": "久保帯人による大ヒット剣戟バトルアクション漫画『BLEACH』を原作としたミュージカル作品。通称および公式ハッシュタグは「ブリミュ」。2005年に初演され、2.5次元ミュージカルの歴史において黎明期からジャンルを牽引してきた金字塔的な親シリーズ。主人公の死神代行・黒崎一護（初代：伊阪達也）が、仲間たちと共に尸魂界（ソウル・ソサエティ）などで激闘を繰り広げる姿を、熱いロックサウンドとダイナミックな殺陣、そして圧倒的な歌唱力で描き出す。原作のスタイリッシュな世界観と舞台ならではのライブ感が融合し、長年にわたり多くの熱狂的なファンを生み出し続けている。",
    "origin_type": "漫画原作",
    "origin_note": "久保帯人（集英社「週刊少年ジャンプ」連載）",
    "production_companies": [
      "ネルケプランニング",
      "ぴえろ"
    ],
    "related_franchise_ids": [],
    "format": "musical",
    "description_en": "A pioneering rock musical adaptation based on the internationally acclaimed sword-fighting battle action manga \"BLEACH\" by Tite Kubo. Commonly known as \"BuriMyu,\" it premiered in 2005 and played a monumental role in establishing and leading the 2.5D musical genre from its early days. The stage production vividly brings to life the epic battles of Substitute Soul Reaper Ichigo Kurosaki (originally played by Tatsuya Isaka) and his comrades through heavy rock music, dynamic sword-fighting choreography, and powerful vocal performances. Renowned for its seamless fusion of the manga's stylish aesthetic with high-energy live theater, the series continues to captivate a deeply passionate fanbase.",
    "name_en": "ROCK MUSICAL BLEACH"
  },
