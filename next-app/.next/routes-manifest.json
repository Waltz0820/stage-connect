{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/actors/[slug]",
      "regex": "^/actors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/actors/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/guide/[slug]",
      "regex": "^/guide/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/guide/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/plays/[slug]",
      "regex": "^/plays/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/plays/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/series/[slug]",
      "regex": "^/series/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/series/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/actors",
      "regex": "^/actors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/actors(?:/)?$"
    },
    {
      "page": "/guide",
      "regex": "^/guide(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/guide(?:/)?$"
    },
    {
      "page": "/plays",
      "regex": "^/plays(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/plays(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/series",
      "regex": "^/series(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/series(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/watch",
      "regex": "^/watch(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/watch(?:/)?$"
    },
    {
      "page": "/watch/danime",
      "regex": "^/watch/danime(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/watch/danime(?:/)?$"
    },
    {
      "page": "/watch/dmm",
      "regex": "^/watch/dmm(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/watch/dmm(?:/)?$"
    },
    {
      "page": "/watch/u-next",
      "regex": "^/watch/u\\-next(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/watch/u\\-next(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}