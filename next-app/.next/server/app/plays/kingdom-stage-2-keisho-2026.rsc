5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"舞台『キングダムII -継承-』\",\"description\":\"連載20周年を迎えた国民的大ヒットコミック『キングダム』の舞台化第2弾。2023年に帝国劇場で上演され、演劇界に旋風を巻き起こした初演に続き、本作では原作でも屈指の人気を誇るエピソード「王騎の死」に至る壮絶な戦いを描く。主人公・信役には、初演から着実にキャリアを重ねパワーアップした三浦宏規と高野洸が続投。秦の大将軍・王騎役も「ミュージカルの帝王」山口祐一郎が引き続き圧倒的な存在感で魅せるほか、本作から飛信隊のキーパーソンとなる羌瘣（きょうかい）も初登場する。演出・山田和也、音楽・KOHTA YAMAMOTOの続投に加え、新進気鋭の笠浦静花が脚本を、藤沢文翁が脚本監修を担当。初演で好評を博した生演奏の熱気はそのままに、若き英雄たちの魂の継承と、戦国乱世の重厚な人間ドラマを極限まで昇華させた歴史スペクタクル巨編。\",\"url\":\"https://stageconnect.jp/plays/kingdom-stage-2-keisho-2026\",\"keywords\":\"漫画原作, アクション濃いめ, 群像・チーム感, 殺陣厚め\",\"about\":\"舞台『キングダム』\",\"actor\":[{\"@type\":\"Person\",\"name\":\"三浦 宏規\",\"url\":\"https://stageconnect.jp/actors/miura-hiroki\"},{\"@type\":\"Person\",\"name\":\"高野 洸\",\"url\":\"https://stageconnect.jp/actors/takano-akira\"},{\"@type\":\"Person\",\"name\":\"山口 祐一郎\",\"url\":\"https://stageconnect.jp/actors/yamaguchi-yuichiro\"}]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"舞台『キングダムII -継承-』"}],["$","p",null,{"className":"lead","children":"連載20周年を迎えた国民的大ヒットコミック『キングダム』の舞台化第2弾。2023年に帝国劇場で上演され、演劇界に旋風を巻き起こした初演に続き、本作では原作でも屈指の人気を誇るエピソード「王騎の死」に至る壮絶な戦いを描く。主人公・信役には、初演から着実にキャリアを重ねパワーアップした三浦宏規と高野洸が続投。秦の大将軍・王騎役も「ミュージカルの帝王」山口祐一郎が引き続き圧倒的な存在感で魅せるほか、本作から飛信隊のキーパーソンとなる羌瘣（きょうかい）も初登場する。演出・山田和也、音楽・KOHTA YAMAMOTOの続投に加え、新進気鋭の笠浦静花が脚本を、藤沢文翁が脚本監修を担当。初演で好評を博した生演奏の熱気はそのままに、若き英雄たちの魂の継承と、戦国乱世の重厚な人間ドラマを極限まで昇華させた歴史スペクタクル巨編。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/kingdom","children":["シリーズ: ","舞台『キングダム』"]}],[["$","span","漫画原作",{"className":"pill","children":["#","漫画原作"]}],["$","span","アクション濃いめ",{"className":"pill","children":["#","アクション濃いめ"]}],["$","span","群像・チーム感",{"className":"pill","children":["#","群像・チーム感"]}],["$","span","殺陣厚め",{"className":"pill","children":["#","殺陣厚め"]}]],null]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演情報"}],["$","div",null,{"className":"meta-list","children":[["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"主な出演者"}],["$","div",null,{"className":"meta-value","children":"三浦 宏規、高野 洸、山口 祐一郎ら"}]]}],["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"期間"}],["$","div",null,{"className":"meta-value","children":"東京: 2026/08/09-09/13 / 大阪: 2026/09/00 / 福岡: 2026/10/00※大阪・福岡日程未定"}]]}],["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"劇場"}],["$","div",null,{"className":"meta-value","children":"東京建物 Brillia HALL / 新歌舞伎座 / 博多座"}]]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"視聴と回遊"}],["$","div",null,{"className":"link-list","children":[null,null,null,["$","$L2",null,{"className":"inline-link","href":"/plays","children":"作品一覧へ戻る"}],["$","$L2",null,{"className":"inline-link","href":"/actors","children":"俳優一覧を見る"}]]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"クレジット"}],["$","div",null,{"className":"meta-list","children":[["$","div","原作-「キングダム」原 泰久（集英社「週刊ヤングジャンプ」連載）",{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"原作"}],["$","div",null,{"className":"meta-value","children":"「キングダム」原 泰久（集英社「週刊ヤングジャンプ」連載）"}]]}],["$","div","演出-山田和也",{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"演出"}],["$","div",null,{"className":"meta-value","children":"山田和也"}]]}],["$","div","脚本-笠浦静花",{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"脚本"}],["$","div",null,{"className":"meta-value","children":"笠浦静花"}]]}],["$","div","音楽-KOHTA YAMAMOTO",{"className":"meta-item","children":["$L10","$L11"]}],"$L12","$L13","$L14"]}]]}],"$L15"]}]]}]
