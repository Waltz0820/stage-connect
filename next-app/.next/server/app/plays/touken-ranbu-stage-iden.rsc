10:T88f,{"@context":"https://schema.org","@type":"CreativeWork","name":"舞台『刀剣乱舞』維伝 朧の志士たち","description":"特命調査「文久土佐」を舞台に、陸奥守吉行ら刀剣男士たちが「放棄された世界」の闇へと挑む新章の幕開け。 西暦2205年。肥前忠広からの緊急要請を受け、陸奥守吉行ら5振りは1863年の文久土佐へと出陣する。そこは土佐勤王党が恐怖政治を敷く、歴史から切り離されたはずの“放棄された世界”だった。現地で肥前、南海太郎朝尊と合流した一行は、歴史改変の中心人物を追う中で、かつての主・坂本龍馬と邂逅する。幕末の志士たちが抱いた壮絶な志と、歴史を守る刀剣男士の在り方が激しく火花を散らす、熱くも切ない維新の物語。","url":"https://stageconnect.jp/plays/touken-ranbu-stage-iden","keywords":"殺陣厚め, ゲーム原作, エモい, 和風モチーフ","about":"舞台『刀剣乱舞』（刀ステ）","actor":[{"@type":"Person","name":"蒼木 陣","url":"https://stageconnect.jp/actors/aoki-jin"},{"@type":"Person","name":"櫻井 圭登","url":"https://stageconnect.jp/actors/sakurai-keito"},{"@type":"Person","name":"三好 大貴","url":"https://stageconnect.jp/actors/miyoshi-daiki"},{"@type":"Person","name":"田淵 累生","url":"https://stageconnect.jp/actors/tabuchi-rui"},{"@type":"Person","name":"小西 詠斗","url":"https://stageconnect.jp/actors/konishi-eito"},{"@type":"Person","name":"玉城 裕規","url":"https://stageconnect.jp/actors/tamaki-yuki"},{"@type":"Person","name":"染谷 俊之","url":"https://stageconnect.jp/actors/someya-toshiyuki"},{"@type":"Person","name":"岡田 達也","url":"https://stageconnect.jp/actors/okada-tatsuya"},{"@type":"Person","name":"神農 直隆","url":"https://stageconnect.jp/actors/kamino-naotaka"},{"@type":"Person","name":"一色 洋平","url":"https://stageconnect.jp/actors/isshiki-yohei"},{"@type":"Person","name":"唐橋 充","url":"https://stageconnect.jp/actors/karahashi-mitsuru"},{"@type":"Person","name":"荒牧 慶彦","url":"https://stageconnect.jp/actors/aramaki-yoshihiko"}]}5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"舞台『刀剣乱舞』維伝 朧の志士たち"}],["$","p",null,{"className":"lead","children":"特命調査「文久土佐」を舞台に、陸奥守吉行ら刀剣男士たちが「放棄された世界」の闇へと挑む新章の幕開け。\n西暦2205年。肥前忠広からの緊急要請を受け、陸奥守吉行ら5振りは1863年の文久土佐へと出陣する。そこは土佐勤王党が恐怖政治を敷く、歴史から切り離されたはずの“放棄された世界”だった。現地で肥前、南海太郎朝尊と合流した一行は、歴史改変の中心人物を追う中で、かつての主・坂本龍馬と邂逅する。幕末の志士たちが抱いた壮絶な志と、歴史を守る刀剣男士の在り方が激しく火花を散らす、熱くも切ない維新の物語。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/butai-touken-ranbu","children":["シリーズ: ","舞台『刀剣乱舞』（刀ステ）"]}],[["$","span","殺陣厚め",{"className":"pill","children":["#","殺陣厚め"]}],["$","span","ゲーム原作",{"className":"pill","children":["#","ゲーム原作"]}],["$","span","エモい",{"className":"pill","children":["#","エモい"]}],["$","span","和風モチーフ",{"className":"pill","children":["#","和風モチーフ"]}]],["$","span",null,{"className":"pill","children":"配信情報あり"}]]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演情報"}],["$","div",null,{"className":"meta-list","children":[["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"主な出演者"}],["$","div",null,{"className":"meta-value","children":"蒼木 陣、櫻井 圭登、三好 大貴ら"}]]}],["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"期間"}],["$","div",null,{"className":"meta-value","children":"東京: 2019/11/22-12/01 / 兵庫: 2019/12/06-12/15 / 東京凱旋: 2019/12/20-2020/01/12 / 福岡: 2020/01/17-01/18"}]]}],["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"劇場"}],["$","div",null,{"className":"meta-value","children":"TOKYO DOME CITY HALL / AiiA 2.5 Theater Kobe / TBS赤坂ACTシアター / 福岡サンパレス ホテル＆ホール"}]]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"視聴と回遊"}],["$","div",null,{"className":"link-list","children":["$L11",null,null,"$L12","$L13"]}]]}]]}],"$L14","