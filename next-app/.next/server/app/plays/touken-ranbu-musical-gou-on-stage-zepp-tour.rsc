5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"ミュージカル『刀剣乱舞』 江 おん すていじ ぜっぷつあー\",\"description\":\"『江 おん すていじ 〜新編 里見八犬伝〜』に出陣した江の刀剣男士6振り（篭手切江、豊前江、桑名江、松井江、五月雨江、村雲江）と、大典太光世、水心子正秀の計8振りが、全国6都市のライブハウス「Zepp」を巡った熱狂のライブツアー。音楽監督にDJ RAITAを迎え、重低音が響き渡るクラブイベントさながらの空間を創出。ライブハウスならではの観客との圧倒的な近さと一体感を武器に、これまでの刀ミュとは一線を画す先鋭的なパフォーマンスを展開し、全国の「主」たちを魅了した。\",\"url\":\"https://stageconnect.jp/plays/touken-ranbu-musical-gou-on-stage-zepp-tour\",\"keywords\":\"ダンス厚め, ライブ感強め, 群像・チーム感, スタイリッシュ\",\"about\":\"ミュージカル『刀剣乱舞』（刀ミュ）\",\"actor\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"ミュージカル『刀剣乱舞』 江 おん すていじ ぜっぷつあー"}],["$","p",null,{"className":"lead","children":"『江 おん すていじ 〜新編 里見八犬伝〜』に出陣した江の刀剣男士6振り（篭手切江、豊前江、桑名江、松井江、五月雨江、村雲江）と、大典太光世、水心子正秀の計8振りが、全国6都市のライブハウス「Zepp」を巡った熱狂のライブツアー。音楽監督にDJ RAITAを迎え、重低音が響き渡るクラブイベントさながらの空間を創出。ライブハウスならではの観客との圧倒的な近さと一体感を武器に、これまでの刀ミュとは一線を画す先鋭的なパフォーマンスを展開し、全国の「主」たちを魅了した。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/touken-ranbu-musical","children":["シリーズ: ","ミュージカル『刀剣乱舞』（刀ミュ）"]}],[["$","span","ダンス厚め",{"className":"pill","children":["#","ダンス厚め"]}],["$","span","ライブ感強め",{"className":"pill","children":["#","ライブ感強め"]}],["$","span","群像・チーム感",{"className":"pill","children":["#","群像・チーム感"]}],["$","span","スタイリッシュ",{"className":"pill","children":["#","スタイリッシュ"]}]],["$","span",null,{"className":"pill","children":"配信情報あり"}]]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":