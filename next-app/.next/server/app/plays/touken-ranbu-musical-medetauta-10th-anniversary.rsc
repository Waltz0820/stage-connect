5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"ミュージカル『刀剣乱舞』 目出度歌誉花舞 十周年祝賀祭\",\"description\":\"2025年7月に東京ドームで開催された、ミュージカル『刀剣乱舞』の10周年を祝う特大アニバーサリーイベント。最大の目玉として、事前に行われた「大当歌誉入札会」の投票（入れ札）結果に基づき、各公演で演目構成が大幅に変化するというファン参加型の特別仕様を採用。刀ミュが歩んできた10年の歴史と軌跡を、規格外のスケールと圧倒的な熱量で祝い上げた祝祭のステージ。\",\"url\":\"https://stageconnect.jp/plays/touken-ranbu-musical-medetauta-10th-anniversary\",\"keywords\":\"ライブ感強め, 客席参加あり, 歌唱厚め, エモい\",\"about\":\"ミュージカル『刀剣乱舞』（刀ミュ）\",\"actor\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"ミュージカル『刀剣乱舞』 目出度歌誉花舞 十周年祝賀祭"}],["$","p",null,{"className":"lead","children":"2025年7月に東京ドームで開催された、ミュージカル『刀剣乱舞』の10周年を祝う特大アニバーサリーイベント。最大の目玉として、事前に行われた「大当歌誉入札会」の投票（入れ札）結果に基づき、各公演で演目構成が大幅に変化するというファン参加型の特別仕様を採用。刀ミュが歩んできた10年の歴史と軌跡を、規格外のスケールと圧倒的な熱量で祝い上げた祝祭のステージ。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/touken-ranbu-musical","children":["シリーズ: ","ミュージカル『刀剣乱舞』（刀ミュ）"]}],[["$","span","ライブ感強め",{"className":"pill","children":["#","ライブ感強め"]}],["$","span","客席参加あり",{"className":"pill","children":["#","客席参加あり"]}],["$","span","歌唱厚め",{"className":"pill","children":["#","歌唱厚め"]}],["$","span","エモい",{"className":"pill","children":["#","エモい"]}]],null]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演情報"}],["$","div",null,{"className":"meta-list","children":[["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"主な出演者"}],["$","