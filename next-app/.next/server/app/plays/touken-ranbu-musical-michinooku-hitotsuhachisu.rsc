5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"ミュージカル『刀剣乱舞』 〜陸奥一蓮〜\",\"description\":\"ミュージカル本公演11作目。三日月宗近、加州清光、蜂須賀虎徹、鶴丸国永、水心子正秀、大包平、山姥切国広という、これまでのシリーズで出陣を重ね、物語の中心を担ってきた名だたる刀剣男士7振りが集結した注目の公演。蝦夷の地を舞台に、阿弖流為、母禮、坂上田村麻呂といった歴史上の人物たちと交錯しながら新たな物語が紡がれる。これまでの刀ミュの歴史と記憶を背負った重厚な編成と、北の大地で繰り広げられるドラマチックな展開がファンの心を強く打った、2024年春の超大作。\",\"url\":\"https://stageconnect.jp/plays/touken-ranbu-musical-michinooku-hitotsuhachisu\",\"keywords\":\"群像のうまみ, 世界観つよめ, 和風モチーフ, セリフ重め\",\"about\":\"ミュージカル『刀剣乱舞』（刀ミュ）\",\"actor\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"ミュージカル『刀剣乱舞』 〜陸奥一蓮〜"}],["$","p",null,{"className":"lead","children":"ミュージカル本公演11作目。三日月宗近、加州清光、蜂須賀虎徹、鶴丸国永、水心子正秀、大包平、山姥切国広という、これまでのシリーズで出陣を重ね、物語の中心を担ってきた名だたる刀剣男士7振りが集結した注目の公演。蝦夷の地を舞台に、阿弖流為、母禮、坂上田村麻呂といった歴史上の人物たちと交錯しながら新たな物語が紡がれる。これまでの刀ミュの歴史と記憶を背負った重厚な編成と、北の大地で繰り広げられるドラマチックな展開がファンの心を強く打った、2024年春の超大作。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/touken-ranbu-musical","children":["シリーズ: ","ミュージカル『刀剣乱舞』（刀ミュ）"]}],[["$","span","群像のうまみ",{"className":"pill","children":["#","群像のうまみ"]}],["$","span","世界観つよめ",{"className":"pill","children":["#","世界観つよめ"]}],["$","span","和風モチーフ",{"className":"pill","children":["#","和風モチーフ"]}],["$","span","セリフ重め",{"className":"pill","children":["#","セリフ重め"]}]],["$","span",null,{"className":"pill","children":"配信情報あり"}]]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演情報"}],["$","div",null,{"classN