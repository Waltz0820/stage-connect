5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"ミュージカル『刀剣乱舞』 加州清光 単騎出陣 アジアツアー\",\"description\":\"2017年、2018年と圧倒的な熱狂を生み出した加州清光のソロライブ公演が、さらに洗練されたステージングとなって海を渡る。刀ミュ史上初となるアジアツアーとして、上海、バンコク、マカオの3都市を巡り、日本凱旋公演として幕張メッセでの大型ライブを敢行。これまでの単騎出陣の集大成とも言える美しく情熱的なパフォーマンスで、アジア中の「主」たちを魅了した。加州清光という唯一無二の存在が、2.5次元エンターテインメントの可能性を世界規模へと押し広げた記念碑的ツアー。\",\"url\":\"https://stageconnect.jp/plays/touken-ranbu-musical-kashu-kiyomitsu-tanki-asia-tour-2019\",\"keywords\":\"ダンス厚め, ライブ感強め, 歌唱厚め, スタイリッシュ\",\"about\":\"ミュージカル『刀剣乱舞』（刀ミュ）\",\"actor\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"ミュージカル『刀剣乱舞』 加州清光 単騎出陣 アジアツアー"}],["$","p",null,{"className":"lead","children":"2017年、2018年と圧倒的な熱狂を生み出した加州清光のソロライブ公演が、さらに洗練されたステージングとなって海を渡る。刀ミュ史上初となるアジアツアーとして、上海、バンコク、マカオの3都市を巡り、日本凱旋公演として幕張メッセでの大型ライブを敢行。これまでの単騎出陣の集大成とも言える美しく情熱的なパフォーマンスで、アジア中の「主」たちを魅了した。加州清光という唯一無二の存在が、2.5次元エンターテインメントの可能性を世界規模へと押し広げた記念碑的ツアー。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/touken-ranbu-musical","children":["シリーズ: ","ミュージカル『刀剣乱舞』（刀ミュ）"]}],[["$","span","ダンス厚め",{"className":"pill","children":["#","ダンス厚め"]}],["$","span","ライブ感強め",{"className":"pill","children":["#","ライブ感強め"]}],["$","span","歌唱厚め",{"className":"pill","children":["#","歌唱厚め"]}],["$","span","スタイリッシュ",{"className":"pill","children":["#","スタイリッシュ"]}]],["$","span",null,{"className":"pill","children":"配信情報あり"}]]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演