5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"舞台『刀剣乱舞』士伝 真贋見極める眼\",\"description\":\"西暦1843年、天保時代の江戸。蜂須賀虎徹を隊長とする部隊は、歴史改変された江戸の愛宕山付近へと出陣する。そこには明暦の大火で焼失したはずの天守閣がそびえ立ち、終わらない「天保の改革」によって国が滅びかねない異様な光景が広がっていた。先行調査員の水心子正秀・源清麿、そして協力者の青年・麟太郎と合流した刀剣男士たちは、改変の中心人物を探るべく奔走する。虎徹三兄弟の葛藤と、新々刀たちが直面する「真贋」の問い。守るべき歴史の重みを懸けた戦いが幕を開ける。\",\"url\":\"https://stageconnect.jp/plays/touken-ranbu-stage-shiden-shingan\",\"keywords\":\"セリフ重め, ゲーム原作, 殺陣厚め, ダークトーン\",\"about\":\"舞台『刀剣乱舞』（刀ステ）\",\"actor\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"舞台『刀剣乱舞』士伝 真贋見極める眼"}],["$","p",null,{"className":"lead","children":"西暦1843年、天保時代の江戸。蜂須賀虎徹を隊長とする部隊は、歴史改変された江戸の愛宕山付近へと出陣する。そこには明暦の大火で焼失したはずの天守閣がそびえ立ち、終わらない「天保の改革」によって国が滅びかねない異様な光景が広がっていた。先行調査員の水心子正秀・源清麿、そして協力者の青年・麟太郎と合流した刀剣男士たちは、改変の中心人物を探るべく奔走する。虎徹三兄弟の葛藤と、新々刀たちが直面する「真贋」の問い。守るべき歴史の重みを懸けた戦いが幕を開ける。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/butai-touken-ranbu","children":["シリーズ: ","舞台『刀剣乱舞』（刀ステ）"]}],[["$","span","セリフ重め",{"className":"pill","children":["#","セリフ重め"]}],["$","span","ゲーム原作",{"className":"pill","children":["#","ゲーム原作"]}],["$","span","殺陣厚め",{"className":"pill","children":["#","殺陣厚め"]}],["$","span","ダークトーン",{"className":"pill","children":["#","ダークトーン"]}]],null]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演情報"}],["$","div",null,{"className":"meta-list","children":[["$","div",null,{"className":"meta-item","children":[["$","div"