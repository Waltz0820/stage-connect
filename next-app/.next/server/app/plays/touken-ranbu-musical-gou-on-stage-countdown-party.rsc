5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"ミュージカル『刀剣乱舞』 江 おん すていじ かうんとだうんぱーてぃー\",\"description\":\"2025年大晦日から2026年元旦にかけて開催された、刀ミュシリーズ初となるカウントダウンイベント。「江」の刀剣男士を中心に、大典太光世、水心子正秀を加えた8振りが出演。全25曲に及ぶライブパフォーマンスに加え、過去の「すていじ」を振り返るトークや紅白対決、全員で「歩」の字を書き上げる書き初め企画など、年越しならではの特別な演出で2026年の幕開けを華々しく飾った。\",\"url\":\"https://stageconnect.jp/plays/touken-ranbu-musical-gou-on-stage-countdown-party\",\"keywords\":\"ライブ感強め, 客席参加あり, 群像のうまみ, スタイリッシュ\",\"about\":\"ミュージカル『刀剣乱舞』（刀ミュ）\",\"actor\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Play Detail SSR"}],["$","h1",null,{"className":"page-title","children":"ミュージカル『刀剣乱舞』 江 おん すていじ かうんとだうんぱーてぃー"}],["$","p",null,{"className":"lead","children":"2025年大晦日から2026年元旦にかけて開催された、刀ミュシリーズ初となるカウントダウンイベント。「江」の刀剣男士を中心に、大典太光世、水心子正秀を加えた8振りが出演。全25曲に及ぶライブパフォーマンスに加え、過去の「すていじ」を振り返るトークや紅白対決、全員で「歩」の字を書き上げる書き初め企画など、年越しならではの特別な演出で2026年の幕開けを華々しく飾った。"}]]}],["$","div",null,{"className":"pill-row","children":[["$","$L2",null,{"className":"pill","href":"/series/touken-ranbu-musical","children":["シリーズ: ","ミュージカル『刀剣乱舞』（刀ミュ）"]}],[["$","span","ライブ感強め",{"className":"pill","children":["#","ライブ感強め"]}],["$","span","客席参加あり",{"className":"pill","children":["#","客席参加あり"]}],["$","span","群像のうまみ",{"className":"pill","children":["#","群像のうまみ"]}],["$","span","スタイリッシュ",{"className":"pill","children":["#","スタイリッシュ"]}]],null]}]]}],["$","div",null,{"className":"grid grid-2","children":[["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公演情報"}],["$","div",null,{"className":"meta-list","children":[["$","div",null,{"className":"meta-item","children":[["$","div",null,{"c