49:["$","article","touken-ranbu-musical-musubi-no-hibiki-hajimari-no-oto",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-musubi-no-hibiki-hajimari-no-oto","children":"ミュージカル『刀剣乱舞』 〜結びの響、始まりの音〜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2018/03/24-04/01 / 大阪: 2018/04/08-04/15 / 東京凱旋: 2018/04/20-05/06"}],["$","div",null,{"className":"cast-role","children":"シリーズ第5作。『幕末天狼傳』から続く新選組の物語が一つの結末を迎える、涙なしには見られない傑作。大和守安定、和泉守兼定、陸奥守吉行、堀川国広、長曽祢虎徹、巴形薙刀の6振りが、大政奉還後の幕末から箱館戦争へと出陣する。武士の時代の終わりと共に散りゆく元の主・土方歳三の最期を前に、刀剣男士たちは己の使命と感情の狭間で激…"}]]}]
4a:["$","article","touken-ranbu-musical-tsuhamono-domo-ga-yume-no-ato",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-tsuhamono-domo-ga-yume-no-ato","children":"ミュージカル『刀剣乱舞』 〜つはものどもがゆめのあと〜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2017/11/04-11/12 / 京都: 2017/11/17-11/19 / 東京凱旋: 2018/01/06-01/14 / 大阪: 2018/01/26-01/30"}],["$","div",null,{"className":"cast-role","children":"鎌倉の世、源頼朝と義経の骨肉の争い、そして奥州藤原氏の滅亡を描くシリーズ第4作。三日月宗近、小狐丸、岩融、今剣の三条派に、新たに源氏の重宝である髭切と膝丸が加わり、阿津賀志山以来の再会と新たな出会いが交錯する。歴史の「正しさ」を守るために、自ら泥を被り続ける三日月宗近の孤独な戦いと、それを察しつつも寄り添う刀たちの想…"}]]}]
4b:["$","article","touken-ranbu-stage-joden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-joden","children":"舞台『刀剣乱舞』ジョ伝 三つら星刀語り"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2017/12/15-12/17 / 大阪: 2017/12/21-12/24 / 福岡: 2017/12/28-12/29"}],["$","div",null,{"className":"cast-role","children":"「序伝（過去）」と「如伝（現在）」の二部構成で描かれる、初期の本丸の物語。黒田官兵衛・長政親子に縁のある刀や、まだ本丸が大きくなる前の山姥切国広の苦悩と成長を描く。 西暦2205年、歴史修正主義者との戦いの中、まだ練度の低かった初期の本丸。山姥切国広率いる第一部隊は、調査任務で訪れた《小田原征伐》の時代で、予期せぬ時…"}]]}]
4c:["$","article","touken-ranbu-musical-shinken-ranbusai-2017",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-shinken-ranbusai-2017","children":"ミュージカル『刀剣乱舞』 ～真剣乱舞祭2017～"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2017/12/08-12/09 / 大阪: 2017/12/12-12/13 / 埼玉: 2017/12/19-12/20 / 中国・広州: 2017/12/23-12/24"}],["$","div",null,{"className":"cast-role","children":"シリーズ第1作から第4作までの総勢16振りの刀剣男士が集結した、刀ミュ史上最大規模のライブ。これまでの軌跡を辿るような重厚な構成に加え、日本武道館やさいたまスーパーアリーナ、さらには海外（広州）公演も成功に収めた。各作品のメインテーマが交差し、百花繚乱のステージが繰り広げられる。三日月宗近と加州清光が同じライブステー…"}]]}]
4d:["$","article","touken-ranbu-stage-gaiden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-gaiden","children":"舞台『刀剣乱舞』外伝 此の夜らの小田原"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"小田原: 2017/11/23"}],["$","div",null,{"className":"cast-role","children":"小田原城の天守閣前で一夜限り上演された、伝説の野外公演。 物語は『ジョ伝』の「序伝」と「如伝」を繋ぐミッシングリンクとなっている。小田原征伐の時代、先行調査に訪れた山姥切国広、へし切長谷部、鶴丸国永の三振りは、まだ改変対象ではないはずの時代に現れた時間遡行軍、そして謎の忍びと対峙する。土砂降りの雨の中で繰り広げられた…"}]]}]
4e:["$","article","touken-ranbu-musical-kashu-kiyomitsu-tanki-2017",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-kashu-kiyomitsu-tanki-2017","children":"ミュージカル『刀剣乱舞』 加州清光 単騎出陣2017"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2017/10/05-10/15"}],["$","div",null,{"className":"cast-role","children":"シリーズ初となる、刀剣男士一振りでのソロライブ公演。「主」への深い愛情と情熱を胸に、加州清光がたった一人で舞台に立ち、圧倒的な歌唱とダンス、妖艶なパフォーマンスで観客を魅了した。これまで本公演や真剣乱舞祭で培ってきた実力を余すところなく発揮し、ダンサーたちを従えて空間を支配する姿はまさに圧巻。刀ミュにおける表現の可能…"}]]}]
4f:["$","article","touken-ranbu-stage-giden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-giden","children":"舞台『刀剣乱舞』義伝 暁の独眼竜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2017/06/01-06/25 / 京都: 2017/06/29-07/02 / 福岡: 2017/07/13-07/14"}],["$","div",null,{"className":"cast-role","children":"シリーズ第2作。伊達政宗と細川忠興、そして彼らに縁のある刀剣男士たちを中心とした物語。 西暦2205年、歴史改変を目論む「歴史修正主義者」に対し、審神者は刀剣男士を過去へ送り込む。ある日の本丸では、悩みを抱える小夜左文字や、調査任務先で仲違いした大倶利伽羅と歌仙兼定など、刀剣男士の間に小さなしこりが生じていた。折しも…"}]]}]
50:["$","article","naruto-stage-akatsuki",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/naruto-stage-akatsuki","children":"ライブ・スペクタクル『NARUTO-ナルト-』〜暁の調べ〜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"NARUTO"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"2017年5月"}],["$","div",null,{"className":"cast-role","children":"「暁」との戦いを描くシリーズ第2弾。サスケ奪還を目指すナルトたちの成長と、イタチとサスケの悲劇的な運命を描く。"}]]}]
51:["$","article","touken-ranbu-musical-mihotose-no-komoriuta-2017",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-mihotose-no-komoriuta-2017","children":"ミュージカル『刀剣乱舞』～三百年の子守唄～"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2017/03/04-03/26 / 大阪: 2017/04/01-04/09 / 東京凱旋: 2017/04/14-04/23"}],["$","div",null,{"className":"cast-role","children":"シリーズ第3作。刀剣男士たちが数十年という途方もない時間をかけ、人間と共に生き、育て、そして看取るという壮大な「大河ドラマ」を描いた名作。遠征先で時間遡行軍の襲撃に遭い、のちの徳川家康となる赤ん坊を拾ったにっかり青江と大倶利伽羅。歴史の修正を図るため、石切丸を隊長に千子村正、蜻蛉切、物吉貞宗を加えた6振りの刀剣男士た…"}]]}]
52:["$","article","touken-ranbu-stage-kyoden-saien",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-kyoden-saien","children":"舞台『刀剣乱舞』虚伝 燃ゆる本能寺 〜再演〜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2016/12/15-12/30 / 福岡: 2017/01/07-01/08 / 大阪: 2017/01/12-01/17"}],["$","div",null,{"className":"cast-role","children":"2016年5月の初演からわずか半年、圧倒的な熱望に応えて上演された再演。織田信長を元の主とする刀剣男士たちの葛藤を描いた物語はそのままに、一部キャストの変更や演出の細かなブラッシュアップを経て、さらに深みを増した。初演が「刀ステ」の誕生だとしたら、この再演はシリーズとしての不動の地位を確立させた一作。ラストの軍議シー…"}]]}]
53:["$","article","touken-ranbu-musical-bakumatsu",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-bakumatsu","children":"ミュージカル『刀剣乱舞』～幕末天狼傳～"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2016/09/24-10/10 / 福岡: 2016/10/15-10/16 / 大阪: 2016/10/21-10/30 / 東京凱旋: 2016/11/17-11/27 / 上海: 2017/01/13-01/15"}],["$","div",null,{"className":"cast-role","children":"シリーズ第2作にして、刀ミュの人気を不動のものにした涙の名作。加州清光を隊長とし、大和守安定、和泉守兼定、堀川国広、長曽祢虎徹、蜂須賀虎徹ら新撰組ゆかりの刀剣男士たちが幕末へ出陣する。動乱の時代を駆け抜け、やがて悲劇的な最期を遂げるかつての主たち。彼らの生き様を間近で見届けることになった刀剣男士たちが、己の使命と元主…"}]]}]
54:["$","article","bungo-stage",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/bungo-stage","children":"舞台「文豪ストレイドッグス」"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"文豪ストレイドッグス"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"2017年12月"}],["$","div",null,{"className":"cast-role","children":"実在の文豪をモデルにしたキャラクターが異能力を使って戦うアクション作品。中島敦は、太宰治らが所属する「武装探偵社」に入社し、ポートマフィアとの抗争に巻き込まれていく。"}]]}]
55:["$","article","touken-ranbu-musical-shinken-ranbusai-2016",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-shinken-ranbusai-2016","children":"ミュージカル『刀剣乱舞』～真剣乱舞祭2016～"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"大阪: 2016/12/13 / 東京: 2016/12/20-12/21"}],["$","div",null,{"className":"cast-role","children":"刀ミュの冬の風物詩となる大型ライブ公演「真剣乱舞祭」の記念すべき第一弾。『阿津賀志山異聞』と『幕末天狼傳』に出陣した刀剣男士11振りが一堂に会し、大阪と東京の大型アリーナを熱狂の渦に巻き込んだ。初期刀である加州清光を中心に構成され、劇中での怒涛の8曲連続歌唱など、圧倒的なパフォーマンスで観客を魅了。空間を縦横無尽に切…"}]]}]
56:["$","article","touken-ranbu-musical-in-itsukushima",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical-in-itsukushima","children":"ミュージカル『刀剣乱舞』 in 嚴島神社"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"広島: 2016/11/12"}],["$","div",null,{"className":"cast-role","children":"世界遺産・嚴島神社の登録20周年を記念し、一夜限りで行われた奇跡の特別公演。『阿津賀志山異聞』の6振りに『幕末天狼傳』の5振りを加えた、総勢11振りの刀剣男士が一堂に会した初のステージング。通常のライブとは異なり、神聖な白装束に身を包んだ刀剣男士たちが、国宝に指定された高舞台で舞い踊る。波の音と夜の闇、そして厳かな和…"}]]}]
57:["$","article","osomatsu-stage",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/osomatsu-stage","children":"舞台『おそ松さん on STAGE』〜SIX MEN’S SHOW TIME〜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"おそ松さん"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"2016年9月"}],["$","div",null,{"className":"cast-role","children":"赤塚不二夫の名作ギャグ漫画を原作としたアニメ『おそ松さん』の舞台化。6つ子とF6の対比が楽しめる。"}]]}]
58:["$","article","tennimu-3rd-hyotei",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/tennimu-3rd-hyotei","children":"ミュージカル『テニスの王子様』3rdシーズン 青学vs氷帝"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『テニスの王子様』1st シーズン（テニミュ1st）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"2016年7月"}],["$","div",null,{"className":"cast-role","children":"関東大会初戦、強豪・氷帝学園との対決。部長・跡部景吾率いる氷帝に対し、手塚国光ら青学が挑む。"}]]}]
59:["$","article","touken-ranbu-musical",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-musical","children":"ミュージカル『刀剣乱舞』〜阿津賀志山異聞〜"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『刀剣乱舞』（刀ミュ）"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2016/05/27-06/12 / 大阪: 2016/06/17-06/19 / 京都: 2016/06/23-06/26"}],["$","div",null,{"className":"cast-role","children":"トライアル公演を経て劇的な進化を遂げた、「刀ミュ」本興行としての記念すべき第一作。三日月宗近ら三条派の刀剣男士と加州清光が、阿津賀志山の戦いを舞台に源義経の悲劇と向き合う重厚な物語。1部のミュージカル、2部のライブパフォーマンスという革新的な二部構成を踏襲しつつ、新たな楽曲を追加し演出をパワーアップさせた完全版として…"}]]}]
