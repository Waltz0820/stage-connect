5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CollectionPage\",\"name\":\"舞台『キングダム』\",\"description\":\"原泰久による国民的大ヒットコミック『キングダム』（集英社「週刊ヤングジャンプ」連載）を原作とし、東宝製作により2023年に帝国劇場で初演された歴史スペクタクル舞台シリーズ。戦乱の春秋戦国時代を舞台に、天下の大将軍を夢見る戦災孤児の少年・信と、のちの始皇帝となる若き秦王・嬴政（えいせい）の果てなき闘いを圧倒的なスケールで描き出す。 本シリーズの最大の特徴は、2.5次元ミュージカルを牽引するトップランナーから、グランドミュージカル界の重鎮、さらには声優やパルクールのスペシャリストまで、ジャンルの垣根を越えた豪華キャストが集結している点にある。オーケストラの生演奏が重厚なドラマを彩り、圧倒的な身体能力と精巧な舞台装置によって劇場を戦場へと変える大迫力のアクションは、演劇界に大きな衝撃を与えた。 2023年の第1弾（王都奪還編・紫夏編）の大ヒットを経て、連載20周年を迎える2026年には待望の第2弾『キングダムII -継承-』が始動。原作屈指の激闘と英雄たちの魂のバトンを描く新章へと突入し、日本演劇界を代表する一大エンターテインメントとして進化を続けている。\",\"url\":\"https://stageconnect.jp/series/kingdom\",\"hasPart\":[{\"@type\":\"CreativeWork\",\"name\":\"舞台『キングダムII -継承-』\",\"url\":\"https://stageconnect.jp/plays/kingdom-stage-2-keisho-2026\"},{\"@type\":\"CreativeWork\",\"name\":\"舞台『キングダム』\",\"url\":\"https://stageconnect.jp/plays/kingdom-stage\"}]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Series Detail SSR"}],["$","h1",null,{"className":"page-title","children":"舞台『キングダム』"}]]}],["$","p",null,{"className":"lead","children":"原泰久による国民的大ヒットコミック『キングダム』（集英社「週刊ヤングジャンプ」連載）を原作とし、東宝製作により2023年に帝国劇場で初演された歴史スペクタクル舞台シリーズ。戦乱の春秋戦国時代を舞台に、天下の大将軍を夢見る戦災孤児の少年・信と、のちの始皇帝となる若き秦王・嬴政（えいせい）の果てなき闘いを圧倒的なスケールで描き出す。\n\n本シリーズの最大の特徴は、2.5次元ミュージカルを牽引するトップランナーから、グランドミュージカル界の重鎮、さらには声優やパルクールのスペシャリストまで、ジャンルの垣根を越えた豪華キャストが集結している点にある。オーケストラの生演奏が重厚なドラマを彩り、圧倒的な身体能力と精巧な舞台装置によって劇場を戦場へと変える大迫力のアクションは、演劇界に大きな衝撃を与えた。\n\n2023年の第1弾（王都奪還編・紫夏編）の大ヒットを経て、連載20周年を迎える2026年には待望の第2弾『キングダムII -継承-』が始動。原作屈指の激闘と英雄たちの魂のバトンを描く新章へと突入し、日本演劇界を代表する一大エンターテインメントとして進化を続けている。"}],["$","div",null,{"className":"pill-row","children":[["$","span",null,{"className":"pill","children":["掲載作品数: ",2]}],["$","span",null,{"className":"pill","children":["種別: ","漫画原作"]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"Series Info"}],["$","div",null,{"className":"meta-list","children":[["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"原作・出典"}],["$","div",null,{"className":"meta-value","children":"「キングダム」原 泰久\n（集英社「週刊ヤングジャンプ」連載）"}]]}],["$","div",null,{"className":"meta-item","children":[["$","div",null,{"className":"meta-label","children":"制作・関連"}],["$","div",null,{"className":"meta-value","children":"東宝"}]]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"出演キャスト・役柄一覧"}],["$","div",null,{"className":"cast-list","children":[["$","article","takano-akira",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/actors/takano-akira","children":"高野 洸"}],null,["$","div",null,{"className":"cast-role","children":"信"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[2,"作品に出演"]}]]}],["$","article","miura-hiroki",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/actors/miura-hiroki","children":"三浦 宏規"}],null,["$","div",null,{"className":"cast-role","children":"信"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[2,"作品に出演"]}]]}],["$","article","yamaguchi-yuichiro",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/actors/yamaguchi-yuichiro","children":"山口 祐一郎"}],null,["$","div",null,{"className":"cast-role","children":"王騎"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[2,"作品に出演"]}]]}],["$","article","hana-yuki",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/actors/hana-yuki","children":"華 優希"}],null,["$","div",null,{"className":"cast-role","children":"河了貂"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[1,"作品に出演"]}]]}],["$","article","kaji-yuki",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/actors/kaji-yuki","children":"梶 裕貴"}],null,"$L10","$L11"]}],"$L12","$L13","$L14"]}]]}],"$L15"]}]]}]
