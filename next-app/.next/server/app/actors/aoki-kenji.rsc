5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"青木 堅治\",\"alternateName\":\"あおき けんじ\",\"description\":\"1980年2月15日生まれ、東京都出身の元俳優・アーティスト。血液型A型。16歳の時にスカウトされ、長身と端正な顔立ちを活かしてモデルとしてキャリアをスタート。雑誌や広告等で活躍したのち、1997年にテレビドラマ『ナースな探偵』で俳優デビューを果たした。 2004年、ミュージカル『テニスの王子様』の『More than Limit 聖ルドルフ学院』にて、聖ルドルフ部長・赤澤吉朗役に抜擢。モデル出身ならではの恵まれた長身とバランスの取れたスタイルを生かし、豪快なプレースタイル（ブレ球）と情に厚い兄貴分気質を、熱量のある芝居とエネルギッシュな歌声で力強く舞台上に立ち上げた。同公演以降も『The Imperial Match 氷帝学園』へのゲスト出演や『Dream Live』シリーズなどテニミュ関連公演に継続して出演し、カンパニーを牽引する人気キャストの一人となった。 俳優業と並行して音楽活動も精力的に展開し、2006年にはテニミュ等で共演した篠田光亮、根本正勝、加藤良輔と共にボーカルユニット「JACKJACK」を結成。舞台と音楽を横断しながらキャラクター性とアーティスト性を高いレベルで両立させ、2.5次元ブーム前夜の若手俳優シーンを熱く盛り上げた功労者として、今も根強いファンに支持されている。\",\"url\":\"https://stageconnect.jp/actors/aoki-kenji\",\"birthDate\":\"1980-02-15\",\"sameAs\":[]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Actor Detail SSR"}],["$","h1",null,{"className":"page-title","children":"青木 堅治"}],["$","div",null,{"className":"muted","children":"あおき けんじ"}]]}],["$","p",null,{"className":"lead","children":"1980年2月15日生まれ、東京都出身の元俳優・アーティスト。血液型A型。16歳の時にスカウトされ、長身と端正な顔立ちを活かしてモデルとしてキャリアをスタート。雑誌や広告等で活躍したのち、1997年にテレビドラマ『ナースな探偵』で俳優デビューを果たした。\n\n2004年、ミュージカル『テニスの王子様』の『More than Limit 聖ルドルフ学院』にて、聖ルドルフ部長・赤澤吉朗役に抜擢。モデル出身ならではの恵まれた長身とバランスの取れたスタイルを生かし、豪快なプレースタイル（ブレ球）と情に厚い兄貴分気質を、熱量のある芝居とエネルギッシュな歌声で力強く舞台上に立ち上げた。同公演以降も『The Imperial Match 氷帝学園』へのゲスト出演や『Dream Live』シリーズなどテニミュ関連公演に継続して出演し、カンパニーを牽引する人気キャストの一人となった。\n\n俳優業と並行して音楽活動も精力的に展開し、2006年にはテニミュ等で共演した篠田光亮、根本正勝、加藤良輔と共にボーカルユニット「JACKJACK」を結成。舞台と音楽を横断しながらキャラクター性とアーティスト性を高いレベルで両立させ、2.5次元ブーム前夜の若手俳優シーンを熱く盛り上げた功労者として、今も根強いファンに支持されている。"}],["$","div",null,{"className":"pill-row","children":[["$","span",null,{"className":"pill","children":["生年月日: ","1980年2月15日"," (46歳)"]}],["$","span",null,{"className":"pill","children":["出演作品数: ",4]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公式リンク"}],["$","div",null,{"className":"inline-links","children":[null,null,null,null,["$","$L2",null,{"className":"inline-link","href":"/actors","children":"俳優一覧へ戻る"}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"出演年表"}],["$","div",null,{"className":"stack-lg","children":[["$","section","2005",{"className":"stack-md","children":[["$","div",null,{"className":"meta-label mono","children":"2005"}],["$","div",null,{"className":"cast-list","children":[["$","article","tennimu-1st-hyotei-winter",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/tennimu-1st-hyotei-winter","children":"ミュージカル『テニスの王子様』The Imperial Match 氷帝学園 in winter 2005-2006"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『テニスの王子様』1st シーズン（テニミュ1st）"}],["$","div",null,{"className":"cast-role","children":"赤澤吉朗"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2005/12/19-12/25 / 大阪: 2005/12/28-2006/01/02"}]]}],["$","article","tennimu-1st-dreamlive-2nd",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/tennimu-1st-dreamlive-2nd","children":"ミュージカル『テニスの王子様』コンサート Dream Live 2nd"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『テニスの王子様』1st シーズン（テニミュ1st）"}],["$","div",null,{"className":"cast-role","children":"赤澤吉朗"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"2005/05/04"}]]}],["$","article","tennimu-1st-yamabuki",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/tennimu-1st-yamabuki","children":"ミュージカル『テニスの王子様』in winter 2004-2005 side 山吹 feat. 聖ルドルフ学院"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"ミュージカル『テニスの王子様』1st シーズン（テニミュ1st）"}],"$L10","$L11"]}]]}]]}],"$L12"]}]]}]]}]]}]
