5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"栗原 功平\",\"alternateName\":\"くりはら こうへい\",\"description\":\"1982年8月9日生まれ、身長173cm、群馬県出身の俳優。名門・劇団スーパー・エキセントリック・シアター（SET）所属。 2004年より同劇団に所属し、長年にわたり数々の舞台で確かな演技力を磨き上げてきた実力派俳優。特技であるアクションやロックダンスで培われた高い身体能力を武器に、ストレートプレイからミュージカル、さらにはNHK大河ドラマ（『青天を衝け』）や人気刑事ドラマ（『相棒』シリーズ）などの映像作品まで、ジャンルを問わずバイプレーヤーとして存在感を発揮している。また、ダンスユニット「Kitty-Guys」のメンバーとしても活動するなど、表現者として多彩な引き出しを持つ。 舞台『刀剣乱舞』シリーズにおいては、新選組総長・山南敬助（さんなん けいすけ）役として『心伝 つけたり奇譚の走馬灯』にて刀ステ本丸に初登場。温厚で知的な「かつての山南」の面影と、新選組の掟に縛られ、歴史の波に狂わされていく「朧の山南」としての悲哀と狂気を、劇団SETで鍛え上げられた圧倒的な芝居心で見事に演じ分けた。加州清光（松田凌）や大和守安定（植田圭輔）ら、かつての仲間たちに立ちはだかる悲劇の総長として、物語に重厚で切ない余韻を残している。\",\"url\":\"https://stageconnect.jp/actors/kurihara-kohei\",\"birthDate\":\"1982-08-09\",\"sameAs\":[\"https://www.set1979.com/member/profile.php?id=16\"]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Actor Detail SSR"}],["$","h1",null,{"className":"page-title","children":"栗原 功平"}],["$","div",null,{"className":"muted","children":"くりはら こうへい"}]]}],["$","p",null,{"className":"lead","children":"1982年8月9日生まれ、身長173cm、群馬県出身の俳優。名門・劇団スーパー・エキセントリック・シアター（SET）所属。\n2004年より同劇団に所属し、長年にわたり数々の舞台で確かな演技力を磨き上げてきた実力派俳優。特技であるアクションやロックダンスで培われた高い身体能力を武器に、ストレートプレイからミュージカル、さらにはNHK大河ドラマ（『青天を衝け』）や人気刑事ドラマ（『相棒』シリーズ）などの映像作品まで、ジャンルを問わずバイプレーヤーとして存在感を発揮している。また、ダンスユニット「Kitty-Guys」のメンバーとしても活動するなど、表現者として多彩な引き出しを持つ。\n\n舞台『刀剣乱舞』シリーズにおいては、新選組総長・山南敬助（さんなん けいすけ）役として『心伝 つけたり奇譚の走馬灯』にて刀ステ本丸に初登場。温厚で知的な「かつての山南」の面影と、新選組の掟に縛られ、歴史の波に狂わされていく「朧の山南」としての悲哀と狂気を、劇団SETで鍛え上げられた圧倒的な芝居心で見事に演じ分けた。加州清光（松田凌）や大和守安定（植田圭輔）ら、かつての仲間たちに立ちはだかる悲劇の総長として、物語に重厚で切ない余韻を残している。"}],["$","div",null,{"className":"pill-row","children":[["$","span",null,{"className":"pill","children":["生年月日: ","1982年8月9日"," (43歳)"]}],["$","span",null,{"className":"pill","children":["出演作品数: ",1]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公式リンク"}],["$","div",null,{"className":"inline-links","children":[null,null,["$","a",null,{"className":"inline-link","href":"https://www.set1979.com/member/profile.php?id=16","target":"_blank","rel":"noopener noreferrer","children":"Official"}],null,["$","$L2",null,{"className":"inline-link","href":"/actors","children":"俳優一覧へ戻る"}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"出演年表"}],["$","div",null,{"className":"stack-lg","children":[["$","section","2024",{"className":"stack-md","children":[["$","div",null,{"className":"meta-label mono","children":"2024"}],["$","div",null,{"className":"cast-list","children":[["$","article","touken-ranbu-stage-shiden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-shiden","children":"舞台『刀剣乱舞』心伝 つけたり奇譚の走馬灯"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"cast-role","children":"山南敬助"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2024/06/08-06/30 / 大阪: 2024/07/05-07/14 / 福岡: 2024/07/19-07/21"}]]}]]}]]}]]}]]}]]}]]}]
