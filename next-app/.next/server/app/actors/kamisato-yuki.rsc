5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"神里 優希\",\"alternateName\":\"かみさと ゆうき\",\"description\":\"1994年10月29日生まれ、身長178㎝、兵庫県出身の俳優。ウィルビー・インターナショナル所属で、端正なビジュアルと抜群のスタイルを活かし、2.5次元ミュージカルから本格的な演劇作品まで幅広く活躍している。 特技は片手側転と、小学校から高校まで打ち込んだサッカー。2015年にミュージカル『テニスの王子様』3rdシーズンで俳優として本格デビューを果たし、青学・不二周助役を担当。天才肌のキャラクターを優雅なフォームと鋭い眼差しで体現し、一躍人気を獲得した。 その後は『錆色のアーマ』シリーズのアゲハ役でミステリアスな存在感を発揮し、同作のアニメ版『錆色のアーマ-黎明-』では声優にも挑戦。舞台『キングダム』では反乱を企てる王弟・成蟜役に抜擢され、プライドが高く冷徹な野心家というこれまでのイメージを覆すヒール役を熱演し、帝劇の舞台に重厚な緊張感をもたらした。 現在はストレートプレイや朗読劇、映像作品への出演など、ジャンルを問わず表現の幅を広げており、華やかな存在感と確かな芝居心を兼ね備えた実力派俳優としての地位を確立している。\",\"url\":\"https://stageconnect.jp/actors/kamisato-yuki\",\"birthDate\":\"1994-10-29\",\"sameAs\":[\"https://x.com/yuki_kamisato\",\"https://willb-artists.com/kamisato_yuki.html\",\"https://www.instagram.com/yuki_kamisato\"]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Actor Detail SSR"}],["$","h1",null,{"className":"page-title","children":"神里 優希"}],["$","div",null,{"className":"muted","children":"かみさと ゆうき"}]]}],["$","p",null,{"className":"lead","children":"1994年10月29日生まれ、身長178㎝、兵庫県出身の俳優。ウィルビー・インターナショナル所属で、端正なビジュアルと抜群のスタイルを活かし、2.5次元ミュージカルから本格的な演劇作品まで幅広く活躍している。\n\n特技は片手側転と、小学校から高校まで打ち込んだサッカー。2015年にミュージカル『テニスの王子様』3rdシーズンで俳優として本格デビューを果たし、青学・不二周助役を担当。天才肌のキャラクターを優雅なフォームと鋭い眼差しで体現し、一躍人気を獲得した。\n\nその後は『錆色のアーマ』シリーズのアゲハ役でミステリアスな存在感を発揮し、同作のアニメ版『錆色のアーマ-黎明-』では声優にも挑戦。舞台『キングダム』では反乱を企てる王弟・成蟜役に抜擢され、プライドが高く冷徹な野心家というこれまでのイメージを覆すヒール役を熱演し、帝劇の舞台に重厚な緊張感をもたらした。\n\n現在はストレートプレイや朗読劇、映像作品への出演など、ジャンルを問わず表現の幅を広げており、華やかな存在感と確かな芝居心を兼ね備えた実力派俳優としての地位を確立している。"}],["$","div",null,{"className":"pill-row","children":[["$","span",null,{"className":"pill","children":["生年月日: ","1994年10月29日"," (31歳)"]}],["$","span",null,{"className":"pill","children":["出演作品数: ",1]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公式リンク"}],["$","div",null,{"className":"inline-links","children":[["$","a",null,{"className":"inline-link","href":"https://x.com/yuki_kamisato","target":"_blank","rel":"noopener noreferrer","children":"X"}],["$","a",null,{"className":"inline-link","href":"https://www.instagram.com/yuki_kamisato","target":"_blank","rel":"noopener noreferrer","children":"Instagram"}],["$","a",null,{"className":"inline-link","href":"https://willb-artists.com/kamisato_yuki.html","target":"_blank","rel":"noopener noreferrer","children":"Official"}],null,["$","$L2",null,{"className":"inline-link","href":"/actors","children":"俳優一覧へ戻る"}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"出演年表"}],["$","div",null,{"className":"stack-lg","children":[["$","section","2023",{"className":"stack-md","children":[["$","div",null,{"className":"meta-label mono","children":"2023"}],["$","div",null,{"className":"cast-list","children":[["$","article","kingdom-stage",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/kingdom-stage","children":"舞台『キングダム』"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『キングダム』"}],["$","div",null,{"className":"cast-role","children":"成蟜"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2023/02/05-02/27 / 大阪: 2023/03/12-03/19 / 福岡: 2023/04/02-04/27 / 北海道: 2023/05/06-05/11"}]]}]]}]]}]]}]]}]]}]]}]
