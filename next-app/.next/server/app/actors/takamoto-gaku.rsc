5:["$","main",null,{"className":"container","style":{"paddingBlock":32},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"高本 学\",\"alternateName\":\"たかもと がく\",\"description\":\"1993年12月31日生まれ、身長180㎝、血液型はA型、大阪府出身の俳優・モデル。ソニー・ミュージックエンタテインメント所属。2015年に開催された「SonyMusic×smart モデル・俳優・タレントオーディション」にてグランプリを獲得し、芸能界入りを果たした。長身と端正な顔立ちを活かし、2.5次元舞台を中心に人気作品のメインキャストを次々と射止めている注目の若手俳優である。 主な出演作に、ミュージカル『ヘタリア』シリーズのプロイセン役や、ミュージカル『スタミュ』の虎石和泉役などがある。 舞台『刀剣乱舞』シリーズでは、天下五剣のひとつとされる太刀・数珠丸恒次（じゅずまるつねつぐ）役として出演。『无伝 夕紅の士 -大坂夏の陣-』にてシリーズ初参戦を果たした。圧倒的な髪量や数珠などの特徴的なビジュアル、そして仏道に帰依する静謐な佇まいを、180cmの長身と伏し目がちの美しい表情で完璧に再現。長大な太刀を軽やかに振るう優雅な殺陣で、天下五剣としての強大な存在感を大坂夏の陣の戦場に刻み込んだ。\",\"url\":\"https://stageconnect.jp/actors/takamoto-gaku\",\"birthDate\":\"1993-12-31\",\"sameAs\":[\"https://x.com/C1Wo705\",\"https://takamotogaku.com/\",\"https://www.instagram.com/gaku.takamoto/\"]}"}}],["$","div",null,{"className":"stack-lg","children":[["$","section",null,{"className":"hero-card stack-md","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Actor Detail SSR"}],["$","h1",null,{"className":"page-title","children":"高本 学"}],["$","div",null,{"className":"muted","children":"たかもと がく"}]]}],["$","p",null,{"className":"lead","children":"1993年12月31日生まれ、身長180㎝、血液型はA型、大阪府出身の俳優・モデル。ソニー・ミュージックエンタテインメント所属。2015年に開催された「SonyMusic×smart モデル・俳優・タレントオーディション」にてグランプリを獲得し、芸能界入りを果たした。長身と端正な顔立ちを活かし、2.5次元舞台を中心に人気作品のメインキャストを次々と射止めている注目の若手俳優である。\n\n主な出演作に、ミュージカル『ヘタリア』シリーズのプロイセン役や、ミュージカル『スタミュ』の虎石和泉役などがある。\n\n舞台『刀剣乱舞』シリーズでは、天下五剣のひとつとされる太刀・数珠丸恒次（じゅずまるつねつぐ）役として出演。『无伝 夕紅の士 -大坂夏の陣-』にてシリーズ初参戦を果たした。圧倒的な髪量や数珠などの特徴的なビジュアル、そして仏道に帰依する静謐な佇まいを、180cmの長身と伏し目がちの美しい表情で完璧に再現。長大な太刀を軽やかに振るう優雅な殺陣で、天下五剣としての強大な存在感を大坂夏の陣の戦場に刻み込んだ。"}],["$","div",null,{"className":"pill-row","children":[["$","span",null,{"className":"pill","children":["生年月日: ","1993年12月31日"," (32歳)"]}],["$","span",null,{"className":"pill","children":["出演作品数: ",2]}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"公式リンク"}],["$","div",null,{"className":"inline-links","children":[["$","a",null,{"className":"inline-link","href":"https://x.com/C1Wo705","target":"_blank","rel":"noopener noreferrer","children":"X"}],["$","a",null,{"className":"inline-link","href":"https://www.instagram.com/gaku.takamoto/","target":"_blank","rel":"noopener noreferrer","children":"Instagram"}],["$","a",null,{"className":"inline-link","href":"https://takamotogaku.com/","target":"_blank","rel":"noopener noreferrer","children":"Official"}],null,["$","$L2",null,{"className":"inline-link","href":"/actors","children":"俳優一覧へ戻る"}]]}]]}],["$","section",null,{"className":"section-card stack-md","children":[["$","h2",null,{"className":"section-title","children":"出演年表"}],["$","div",null,{"className":"stack-lg","children":[["$","section","2023",{"className":"stack-md","children":[["$","div",null,{"className":"meta-label mono","children":"2023"}],["$","div",null,{"className":"cast-list","children":[["$","article","touken-ranbu-stage-7th-anniversary",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-7th-anniversary","children":"舞台『刀剣乱舞』七周年感謝祭 −夢語刀宴會−"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"cast-role","children":"数珠丸恒次"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"千葉: 2023/08/04-08/06"}]]}]]}]]}],["$","section","2021",{"className":"stack-md","children":[["$","div",null,{"className":"meta-label mono","children":"2021"}],["$","div",null,{"className":"cast-list","children":[["$","article","touken-ranbu-stage-muden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/plays/touken-ranbu-stage-muden","children":"舞台『刀剣乱舞』无伝 夕紅の士 −大坂夏の陣−"}],["$","div",null,{"className":"muted","style":{"marginTop":4},"children":"舞台『刀剣乱舞』（刀ステ）"}],["$","div",null,{"className":"cast-role","children":"数珠丸恒次"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":"東京: 2021/04/11-06/27"}]]}]]}]]}]]}]]}]]}]]}]
