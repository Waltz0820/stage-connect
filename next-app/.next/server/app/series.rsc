7f:["$","article","saint-seiya",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/saint-seiya","children":"舞台「聖闘士星矢」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"車田正美による人気漫画『聖闘士星矢』を原作とした2.5次元ミュージカル作品。聖闘士（セイント）と呼ばれる少年たちの戦いを、歌やダンス、アクションを交えて描くのが特徴である。2011年に上演されたスーパーミュージカル版では、演出を茅野イサム、脚本を三井秀樹が手掛けた。"}]]}]
80:["$","article","aoyama-operetta",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/aoyama-operetta","children":"舞台「青山オペレッタ」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"DMM GAMESのメディアミックスプロジェクト『青山オペレッタ』を原作とした2.5次元舞台。未婚の若い男性のみで構成される歌劇団を舞台に、声優がキャラクターをそのまま演じるのが特徴だ。ドラマ、劇中劇、レビューの3部構成で、歌やダンスを交えた華やかなステージが繰り広げられる。脚本・演出は主に村井雄が手掛ける。"}]]}]
81:["$","article","senbonzakura",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/senbonzakura","children":"舞台「千本桜」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"黒うさPによる大人気ボーカロイド楽曲『千本桜』を原案とした2.5次元歌劇。大正浪漫の雰囲気漂う帝都・桜京を舞台に、現代から転生した初音未來たちが「影憑」と呼ばれる闇の勢力に立ち向かう姿を、歌やダンスを交えて描く。脚本・演出はトクナガヒデカツが手掛けている。"}]]}]
82:["$","article","sousei-no-aquarion",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/sousei-no-aquarion","children":"舞台「創聖のアクエリオン」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"河森正治原作のアニメ『創聖のアクエリオン』を舞台化した2.5次元作品。声優がセリフを、俳優が動きをそれぞれ担当する「Live Voice」という独特の演出が特徴である。脚本・演出は柿ノ木タケヲが手掛け、原作の壮大な世界観と「合体」を新たな形で表現している。"}]]}]
83:["$","article","ikebukuro-west-gate-park",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/ikebukuro-west-gate-park","children":"舞台「池袋ウエストゲートパーク」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"石田衣良の小説『池袋ウエストゲートパーク』を原作とした2.5次元舞台。品川ヒロシが演出、毛利亘宏が脚本を手掛け、原作の世界観を歌やダンス、アクションを交えて力強く描き出す。池袋を舞台に、主人公のマコトが様々な事件を解決していく姿が描かれる。"}]]}]
84:["$","article","teiichi-no-kuni",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/teiichi-no-kuni","children":"舞台「帝一の國」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"古屋兎丸の同名漫画を原作とした2.5次元舞台作品、學蘭歌劇『帝一の國』。名門男子校を舞台に、生徒会長の座を巡って繰り広げられる学園政権闘争を描く。脚本・喜安浩平、演出・小林顕作による、歌やダンス、ギャグをふんだんに盛り込んだコメディ・ミュージカルであることが大きな特徴となっている。"}]]}]
85:["$","article","donten-ni-warau",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/donten-ni-warau","children":"舞台「曇天に笑う」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"唐々煙による人気漫画『曇天に笑う』を原作とした2.5次元舞台作品。明治時代を舞台に、曇天三兄弟の活躍と絆を描く。脚本を高橋悠也、演出を菜月チョビが手掛け、ダイナミックな殺陣が見どころである。"}]]}]
86:["$","article","hakkenden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/hakkenden","children":"舞台「八犬伝」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"碧也ぴんくの漫画『八犬伝 -東方八犬異聞-』を原作とした2.5次元舞台作品。曲亭馬琴の『南総里見八犬伝』をベースに、八犬士たちの運命的な出会いと戦いを描く壮大な歴史ファンタジーである。舞台ならではの迫力ある殺陣やアクションシーンが見どころとなっている。"}]]}]
87:["$","article","bishounen-tanteidan",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/bishounen-tanteidan","children":"舞台「美少年探偵団」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"西尾維新の小説『美少年シリーズ』を原作とした2.5次元舞台作品。歌とダンスを交えた「歌劇」として上演され、個性豊かな美少年たちが学園内の事件を解決していく爽快青春ミステリーを描く。演出を三浦香、脚本を畑雅文が手掛けている。"}]]}]
88:["$","article","binan-koukou-chikyuu-boueibu-love",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/binan-koukou-chikyuu-boueibu-love","children":"舞台「美男高校地球防衛部LOVE!」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"高松信司原作のTVアニメ『美男高校地球防衛部LOVE!』を原案とした2.5次元舞台作品。男子高校生たちが愛の力（？）で地球を守るという斬新な設定のコメディで、ライブパフォーマンスさながらの歌やダンスが大きな見どころである。脚本・演出は村井雄が手がける。"}]]}]
89:["$","article","bungou-to-alchemist",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/bungou-to-alchemist","children":"舞台「文豪とアルケミスト」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"DMM GAMESの文豪転生シミュレーションゲーム『文豪とアルケミスト』を原作とした2.5次元舞台作品。文学を侵蝕する者たちから文学書を守るため、転生した文豪たちが戦う姿を描く。脚本はなるせゆうせい、演出は吉谷光太郎が一貫して手掛け、美麗な衣装と激しい殺陣が大きな魅力となっている。"}]]}]
8a:["$","article","boukyaku-battery",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/boukyaku-battery","children":"舞台「忘却バッテリー」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"みかわ絵子による人気漫画『忘却バッテリー』を原作とした2.5次元舞台作品。中学野球界で最強と恐れられた怪物バッテリーが、野球無名校で再会することから物語が始まる。脚本・演出は山崎彬が手掛け、高校野球の人間ドラマを熱く描く。"}]]}]
8b:["$","article","hokuto-no-ken",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/hokuto-no-ken","children":"舞台「北斗の拳」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"武論尊・原哲夫による伝説的漫画『北斗の拳』を原作とした2.5次元ミュージカル。最終戦争後の世紀末を舞台に、北斗神拳伝承者ケンシロウが愛と哀しみを背負い救世主として成長する姿を描く。フランク・ワイルドホーンの音楽にのせた、魂を揺さぶるアクションシーンが大きな見どころである。"}]]}]
8c:["$","article","makai-ouji",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/makai-ouji","children":"舞台「魔界王子」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"高殿円・雪広うたこ原作の漫画『魔界王子 devils and realist』を原案とした2.5次元ミュージカル作品。悪魔たちが魔界の代理王候補を巡って争うファンタジーストーリーを、キャッチーなミュージカルナンバーに乗せて描く。演出は元吉庸泰が手掛け、制作はCLIEが担当している。"}]]}]
8d:["$","article","makai-tenshou",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/makai-tenshou","children":"舞台「魔界転生」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"山田風太郎の同名小説を原作としたエンターテインメント時代劇。脚本マキノノゾミ、演出堤幸彦により舞台化された。島原の乱で死んだ天草四郎が魔界の力で蘇り、歴史上の剣豪たちを次々と転生させて幕府転覆を狙う。派手なアクションやスペクタクルな演出で、剣豪・柳生十兵衛と魔界衆との壮絶な戦いを描く。"}]]}]
8e:["$","article","madou-soshi",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/madou-soshi","children":"舞台「魔道祖師」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"中国の人気小説『魔道祖師』を原作とした2.5次元舞台作品。妖魔や邪鬼が蔓延る古代中国を舞台に、強い絆で結ばれた二人の激動の運命を描く。脚本・演出は伊勢直弘が手掛けており、剣と法術を駆使した壮大な物語が展開される。"}]]}]
8f:["$","article","bakumatsu-rock",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/bakumatsu-rock","children":"舞台「幕末Rock」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"マーベラスの同名ゲームを原作とした2.5次元ミュージカル、「超歌劇（ウルトラミュージカル）『幕末Rock』」。歌で幕府を倒すという斬新な設定で、坂本龍馬ら志士たちの熱い魂の叫びをロックミュージックに乗せて描く。吉谷光太郎の脚本・演出による、ライブさながらの迫力あるパフォーマンスが魅力だ。"}]]}]
90:["$","article","mirai-shounen-conan",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/mirai-shounen-conan","children":"舞台「未来少年コナン」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"宮崎駿が監督した日本アニメーション制作のアニメ『未来少年コナン』を原作とした舞台作品。イスラエルの演出家インバル・ピントとフランスの演出家ダビッド・マンブッフが共同で演出し、演劇、ダンス、歌を融合させたフィジカルシアターとして表現する。アナログとデジタルを駆使した美しい演出で、未来の世界を壮大に描いている。"}]]}]
91:["$","article","yume-oukoku-to-nemureru-100-nin-no-ouji-sama",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/yume-oukoku-to-nemureru-100-nin-no-ouji-sama","children":"舞台「夢王国と眠れる100人の王子様」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"ジークレスト原作のスマートフォン向けパズルRPG『夢王国と眠れる100人の王子様』を原案とした2.5次元舞台。音楽CDシリーズのキャラクターを中心に、歌やダンスを交えたきらびやかなステージが特徴のミュージカル作品である。初期公演では、ますもとたくやが脚本・演出を手掛けた。"}]]}]
92:["$","article","yumeiro-cast",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/yumeiro-cast","children":"舞台「夢色キャスト」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"セガの恋するミュージカルリズムゲーム『夢色キャスト』を原作とした舞台作品。「ミュージカル・リズムステージ」と銘打たれ、俳優陣による歌やダンスを交えたライブパフォーマンスが魅力である。脚本は川邊優子、演出は佐藤徹也が担当し、ゲームの世界観をステージ上で表現している。"}]]}]
93:["$","article","meiji-tokyo-renka",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/meiji-tokyo-renka","children":"舞台「明治東亰恋伽」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"MAGES.の同名恋愛アドベンチャーゲームを原作とした2.5次元ミュージカル作品。明治時代にタイムスリップした主人公と偉人たちとの恋愛模様を、歌とダンスを交えて描く「歌劇」として上演されている。脚本を桜木さやか、演出を吉谷光太郎が一貫して手掛けている点が特徴である。"}]]}]
94:["$","article","uchouten-kazoku",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/uchouten-kazoku","children":"舞台「有頂天家族」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"森見登美彦の人気小説を原作とした2.5次元舞台「有頂天家族」。人間と狸、天狗が共存する京都を舞台に、狸一家の三男坊・矢三郎が巻き起こす奇想天外な騒動を描いたコメディ作品である。脚本・演出はG2が手掛け、個性豊かなキャラクターたちが織りなす物語をストレートプレイで表現する。"}]]}]
95:["$","article","ryu-ga-gotoku",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/ryu-ga-gotoku","children":"舞台「龍が如く」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"セガの人気ゲーム『龍が如く』を原作とした2.5次元舞台作品。シリーズ10周年を記念して上演された本作は、原作の重厚なストーリーをベースに、迫力あるアクションや殺陣を交えて伝説の極道・桐生一馬の生き様を描く。脚本・演出は田村孝裕が手掛けている。"}]]}]
96:["$","article","rengoku-ni-warau",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/rengoku-ni-warau","children":"舞台「煉獄に笑う」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"唐々煙による人気漫画『煉獄に笑う』を原作とした2.5次元舞台作品。戦国時代の琵琶湖を舞台に、300年に一度甦る伝説の化物「大蛇（おろち）」を巡る戦いを描く。脚本・演出は西田大輔が担当し、詩吟や和楽器とロックを融合させた音楽も特徴である。"}]]}]
97:["$","article","aku-no-hana",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/aku-no-hana","children":"舞台「惡の華」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"押見修造による人気漫画『惡の華』を原作とした2.5次元舞台作品。思春期の少年少女が抱える鬱屈と衝動を描いた原作の世界観を、実力派の俳優陣が体現する。劇団た組。によって2016年に初めて上演され、脚本・演出は加藤拓也が手掛けた。人間の本質に迫るサスペンスフルな物語が特徴である。"}]]}]
98:["$","article","mouryou-no-hako",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/mouryou-no-hako","children":"舞台「魍魎の匣」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"京極夏彦の長編小説『魍魎の匣』を原作とした舞台作品。戦後間もない昭和を舞台に、「憑物落とし」の京極堂が奇怪な事件の謎に挑むミステリー。脚本を畑雅文、演出を松崎史也が手掛け、原作の持つ独特の世界観を表現している。"}]]}]
99:["$","article","bleach",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/bleach","children":"舞台『BLEACH』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"久保帯人による人気漫画『BLEACH』を原作とした2.5次元舞台作品、「ROCK MUSICAL BLEACH」。“ロックと剣劇”をコンセプトに、迫力ある殺陣とロックミュージックが融合したステージが特徴である。制作はネルケプランニングが手掛け、2.5次元ミュージカルの先駆け的存在として知られている。"}]]}]
9a:["$","article","hunter-x-hunter",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/hunter-x-hunter","children":"舞台『HUNTER×HUNTER』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"冨樫義博による大人気漫画『HUNTER×HUNTER』を原作とした2.5次元舞台作品。脚本・演出は山崎彬が一貫して手掛けている。原作の壮大な冒険を、迫力ある殺陣やダンス、そして音楽の融合で表現し、多くのファンを魅了している。"}]]}]
9b:["$","article","i-chu",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/i-chu","children":"舞台『アイ☆チュウ』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"リベル・エンタテインメント原作のアイドル育成ゲーム『アイ☆チュウ』を舞台化した2.5次元ミュージカル作品。アイドルになる途中のアイチュウたちが歌やダンスを繰り広げるライブパフォーマンスが特徴である。脚本・演出は多くを伊勢直弘が手掛け、原作の世界観をステージ上で鮮やかに再現している。"}]]}]
9c:["$","article","idolmaster-sidem",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/idolmaster-sidem","children":"舞台『アイドルマスター SideM』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"ゲーム『アイドルマスター SideM』を原作とした2.5次元舞台作品。通称「サイステ」。“理由あって、アイドル！”をコンセプトに、様々な理由を抱えた男性アイドルたちの成長と絆をドラマチックなライブパフォーマンスで描く。脚本を佐野瑞樹、演出を荒木宏文が手掛けている。"}]]}]
9d:["$","article","gag-manga-biyori",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/gag-manga-biyori","children":"舞台『ギャグマンガ日和』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"増田こうすけによる人気ギャグ漫画『ギャグマンガ日和』を原作とした2.5次元舞台。シュールでカオスな世界観を忠実に再現したコメディ作品である。脚本・演出は、シリーズを通してなるせゆうせいが手掛けている。"}]]}]
9e:["$","article","captain-tsubasa",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/captain-tsubasa","children":"舞台『キャプテン翼』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"高橋陽一原作のサッカー漫画『キャプテン翼』を舞台化した「超体感ステージ」。デジタル技術とパフォーマーの身体能力を融合させ、作中の必殺技をリアルに再現するのが特徴である。ソニー開発の触覚提示技術により、観客が作中の衝撃を体感できる演出も取り入れられた。総合演出はEBIKEN、脚本は加世田剛が担当。"}]]}]
9f:["$","article","kemono-friends",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/kemono-friends","children":"舞台『けものフレンズ』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"メディアミックス作品「けものフレンズプロジェクト」を原案とした2.5次元舞台。動物たちがヒトの姿になった「フレンズ」たちが暮らすジャパリパークを舞台に、歌やダンス、心温まる冒険を繰り広げる。脚本・演出は村上大樹が一貫して手掛けており、ファミリーでも楽しめるライブエンターテイメント性の高いステージが魅力である。"}]]}]
a0:["$","article","cyborg-009",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/cyborg-009","children":"舞台『サイボーグ009』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"石ノ森章太郎の不朽の名作漫画『サイボーグ009』を原作とした2.5次元舞台作品。原作60周年を記念して上演され、演出に植木豪、脚本に亀田真二郎を迎えている。個性豊かなサイボーグ戦士たちの活躍を、迫力あるアクションやダンス、音楽劇の要素を交えて描く。"}]]}]
a1:["$","article","sakura-taisen",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/sakura-taisen","children":"舞台『サクラ大戦』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"セガの人気ゲーム『サクラ大戦』シリーズを原作とした2.5次元舞台。歌、ダンス、殺陣をふんだんに取り入れたミュージカル（歌謡ショウ）形式が特徴である。プロジェクションマッピングなどの最新の舞台演出も駆使し、原作の世界観を忠実に再現している。"}]]}]
a2:["$","article","joker-game",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/joker-game","children":"舞台『ジョーカー・ゲーム』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"柳広司の小説『ジョーカー・ゲーム』シリーズを原案とした2.5次元舞台作品。第二次世界大戦下の日本を舞台に、スパイ養成機関「D機関」のメンバーが繰り広げる頭脳戦とアクションを描く。脚本・演出は西田大輔が一貫して手掛けており、緊迫感あふれる心理描写が特徴である。"}]]}]
a3:["$","article","precure",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/precure","children":"舞台『プリキュア』シリーズ"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"東映アニメーションの女児向けアニメ『プリキュア』シリーズを原案とし、男子高校生がプリキュアに変身するという舞台オリジナルの物語を描く2.5次元舞台作品。ダンス＆バトルをふんだんに取り入れた心躍るステージが特徴。脚本・演出はほさかようが一貫して手掛けている。"}]]}]
a4:["$","article","fruits-basket",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/fruits-basket","children":"舞台『フルーツバスケット』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"高屋奈月による人気漫画『フルーツバスケット』を原作とした2.5次元舞台作品。脚本・演出を毛利亘宏（少年社中）が手掛け、本田透と十二支の呪いを持つ草摩家との心温まる交流を描く。ランウェイ型のステージを活かした演出が特徴で、切なくも優しい物語が観客を魅了する。"}]]}]
a5:["$","article","blue-lock",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/blue-lock","children":"舞台『ブルーロック』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"金城宗幸・ノ村優介による大人気サッカー漫画『ブルーロック』を原作とした舞台化作品。最強のストライカーを育成する「青い監獄（ブルーロック）」プロジェクトでの熱い戦いを、プロジェクションマッピングや俳優の身体能力を駆使した演出で描く。脚本・演出は伊勢直弘が手掛け、制作はOffice ENDLESSが担当している。"}]]}]
a6:["$","article","hetalia",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/hetalia","children":"舞台『ヘタリア』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"日丸屋秀和による国擬人化コメディ漫画『ヘタリア Axis Powers』を原作としたミュージカル作品、通称「ヘタミュ」。個性豊かな国々が歌やダンスを交え、歴史上の出来事をベースにした物語をコミカルに繰り広げる。脚本はなるせゆうせい、演出は吉谷光太郎が一貫して手掛けている。"}]]}]
a7:["$","article","persona",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/persona","children":"舞台『ペルソナ』シリーズ"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"アトラスの人気ジュブナイルRPG『ペルソナ』シリーズを原作とした2.5次元舞台化作品。原作のスタイリッシュな世界観をそのままに、ペルソナ能力を駆使した派手なアクションやダンスで物語を表現する。各シリーズで脚本・演出家は異なるが、原作の持つ魅力的なストーリーと音楽で観客を魅了し続けている。"}]]}]
a8:["$","article","my-home-hero",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/my-home-hero","children":"舞台『マイホームヒーロー』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"山川直輝・朝基まさしによる漫画『マイホームヒーロー』を原作とした2.5次元舞台作品。愛する娘を守るため、その彼氏を殺害してしまった平凡なサラリーマンの闘いを描くクライムサスペンスである。脚本を月森葵、演出を加古臨王が手掛け、手に汗握る心理戦とシリアスな物語が展開される。"}]]}]
a9:["$","article","katekyo-hitman-reborn",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/katekyo-hitman-reborn","children":"舞台『家庭教師ヒットマンREBORN!』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"天野明による人気漫画『家庭教師ヒットマンREBORN!』を原作とした2.5次元舞台作品。原作の物語を追体験できるシリーズとして展開し、キャラクターが持つ特殊な武器と映像演出を組み合わせた派手なアクションシーンが大きな特徴となっている。脚本・演出は丸尾丸一郎（劇団鹿殺し）が担当。"}]]}]
aa:["$","article","gyakuten-saiban",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/gyakuten-saiban","children":"舞台『逆転裁判』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"カプコンの人気法廷アドベンチャーゲーム『逆転裁判』を原作とした2.5次元舞台化作品。弁護士・成歩堂龍一が、無実の罪に問われた依頼人を救うため法廷で戦う姿を描く。脚本は多くを斎藤栄作が手掛け、ゲームの世界観を大切にしつつ、舞台ならではのオリジナルストーリーや演出が魅力となっている。"}]]}]
ab:["$","article","kiniro-no-corda",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/kiniro-no-corda","children":"舞台『金色のコルダ』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"コーエーテクモゲームスの人気ゲーム『金色のコルダ』を原作とし、主にアニメ『金色のコルダ Blue♪Sky』をベースに舞台化した2.5次元音楽劇シリーズ。全国学生音楽コンクールを舞台に、音楽に青春を捧げる高校生たちの葛藤や成長を描く。脚本・演出は多くを吉谷光太郎が手掛けている。"}]]}]
ac:["$","article","ginga-tetsudou-999",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/ginga-tetsudou-999","children":"舞台『銀河鉄道999』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"松本零士の不朽の名作漫画『銀河鉄道999』を原作とした舞台化作品。2018年の40周年記念公演では、脚本を坪田文、演出を児玉明子が担当し、主人公・星野鉄郎の新たな旅立ちを描いた。ミュージカル要素や映像演出を駆使し、壮大な宇宙の物語を表現しているのが特徴である。"}]]}]
ad:["$","article","kekkai-sensen",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/kekkai-sensen","children":"舞台『血界戦線』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"内藤泰弘による人気漫画『血界戦線』を原作とした2.5次元舞台作品である。脚本・演出は西田大輔が手掛け、混沌とした都市ヘルサレムズ・ロットを舞台に、秘密結社ライブラのメンバーたちの活躍を描く。個性的なアクションや生演奏を交えた演出が大きな特徴となっている。"}]]}]
ae:["$","article","inuyasha",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/inuyasha","children":"舞台『犬夜叉』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"高橋留美子の人気漫画『犬夜叉』を原作とした2.5次元舞台作品。戦国時代を舞台に、半妖の犬夜叉と現代から来た少女かごめが四魂の玉を巡る冒険を繰り広げる。迫力ある殺陣とキャラクターの高い再現度が特徴で、2017年公演では脚本を松村武、演出を茅野イサムが担当した。"}]]}]
af:["$","article","gensou-suikoden",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/gensou-suikoden","children":"舞台『幻想水滸伝』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"コナミの人気RPG『幻想水滸伝』を原作とした2.5次元舞台作品。生と死を司る紋章を巡る「門の紋章戦争」の壮大な物語を描く。脚本・演出は中屋敷法仁が手掛け、重厚なストーリーと個性豊かなキャラクターたちが織りなす人間ドラマが魅力である。"}]]}]
b0:["$","article","hagane-no-renkinjutsushi",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/hagane-no-renkinjutsushi","children":"舞台『鋼の錬金術師』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"荒川弘によるダークファンタジー漫画の金字塔『鋼の錬金術師』を原作とした舞台化作品。錬金術を駆使した派手なアクションと、壮大なスケールで描かれる兄弟の絆の物語が特徴である。脚本・演出は石丸さち子が手掛け、原作の世界観を忠実に再現しつつ、舞台ならではの表現で観客を魅了する。"}]]}]
b1:["$","article","kuroko-no-basuke",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/kuroko-no-basuke","children":"舞台『黒子のバスケ』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"藤巻忠俊による大人気バスケットボール漫画『黒子のバスケ』を原作とした舞台化作品。演出家・中屋敷法仁による、コートを縦横無尽に駆け巡るような演出でバスケットボールの試合を表現し、登場人物たちの成長や人間ドラマを描き出す。制作はバンダイナムコライブクリエイティブが手掛けている。"}]]}]
b2:["$","article","saiyuki",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/saiyuki","children":"舞台『最遊記』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"峰倉かずやの人気漫画『最遊記』を原作とした2.5次元ミュージカル作品。「歌劇伝」と銘打ち、歌やダンスを交えながら三蔵一行の旅路と戦いを描く。シリーズの多くで脚本・演出を三浦香が手掛けており、原作の世界観を忠実に再現した熱いステージが魅力である。"}]]}]
b3:["$","article","oshi-no-ko",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/oshi-no-ko","children":"舞台『推しの子』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"赤坂アカ・横槍メンゴによる人気漫画『【推しの子】』を原作とした2.5次元舞台作品。原作の「2.5次元舞台編」をベースに、漫画の舞台化に奮闘する登場人物たちの姿を熱く描く。脚本・演出は中屋敷法仁が、制作はゴーチ・ブラザーズが担当。"}]]}]
b4:["$","article","ao-no-exorcist",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/ao-no-exorcist","children":"舞台『青の祓魔師』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"加藤和恵による人気漫画『青の祓魔師』を原作とした2.5次元舞台作品。魔神の血を引く少年・奥村燐が、仲間たちと共に悪魔と戦う祓魔師を目指すダークファンタジーである。迫力ある殺陣を駆使したバトルシーンや、兄弟の絆を描く熱いストーリーが見どころとなっている。"}]]}]
b5:["$","article","sengoku-basara",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/sengoku-basara","children":"舞台『戦国BASARA』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"カプコンの人気アクションゲーム『戦国BASARA』を原作とした2.5次元舞台作品。原作の派手なアクションを再現した迫力ある殺陣と、個性豊かな武将たちが織りなす熱いストーリーが魅力である。多くの公演で西田大輔が脚本・演出を手掛けている。"}]]}]
b6:["$","article","sengoku-musou",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/sengoku-musou","children":"舞台『戦国無双』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"コーエーテクモゲームスの人気アクションゲーム『戦国無双』シリーズを原作とした舞台化作品。ゲームの世界観を忠実に再現し、大迫力の殺陣と武将たちの熱い人間ドラマが描かれる。脚本・演出は吉谷光太郎が手掛け、壮大な戦国絵巻を繰り広げる。"}]]}]
b7:["$","article","tokyo-ghoul",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/tokyo-ghoul","children":"舞台『東京喰種トーキョーグール』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"石田スイ原作の人気漫画『東京喰種トーキョーグール』を舞台化した2.5次元作品。人間と人を喰らう怪人“喰種（グール）”の狭間で葛藤する主人公の姿を、ダークな世界観の中で描く。演出・茅野イサム、脚本・御笠ノ忠次が手掛け、迫力ある殺陣やアクションを交えたシリアスな物語が展開される。"}]]}]
b8:["$","article","harukanaru-toki-no-naka-de",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/harukanaru-toki-no-naka-de","children":"舞台『遙かなる時空の中で』"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"コーエーテクモゲームスの人気恋愛アドベンチャーゲーム『遙かなる時空の中で』を原作とした2.5次元舞台。現代の女子高生が神子として異世界へ召喚され、八葉と呼ばれる男性たちと世界の危機を救う和風ファンタジーである。殺陣やダンスを交えた華やかな演出と、原作のマルチエンディングを再現した舞台構成が人気を集めている。"}]]}]
