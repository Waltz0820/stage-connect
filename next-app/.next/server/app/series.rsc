3b:["$","article","nikke",{"className":"cast-card","children":[["$","$L2",null,{"className":"cast-name","href":"/series/nikke","children":"舞台「NIKKE」"}],["$","div",null,{"className":"muted","style":{"marginTop":8,"fontSize":13},"children":[0,"作品"]}],["$","div",null,{"className":"cast-role","children":"SHIFT UP開発のスマートフォン向けガンガールRPG『勝利の女神：NIKKE』を原案とした2.5次元舞台作品。人類の存亡をかけ戦う少女型ヒューマノイド「ニケ」の物語を、迫力ある殺陣や銃撃戦を交えて描く。脚本・演出は久保田唱が、企画・制作はHIKEが一貫して手掛けている。"}]]}]
